# ==============================================================================
# PRAC4TOEIC BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền các giá trị cấu hình thực tế
# ==============================================================================

# Server
SERVER_PORT=8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prac4toeic
DB_USER=postgres
DB_PASSWORD=postgres

# JPA & Hibernate (update | validate | create | create-drop)
HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true

# Security & JWT (Key 256-bit Hex/Base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800
JWT_ISSUER=prac4toeic-api

# AI Services (Gemini / STT)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Object Storage (Cloudinary / S3 lưu audio & hình ảnh bài thi)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
